rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ผู้ใช้แต่ละคน อ่าน/เขียนได้เฉพาะแผนของตัวเอง (PLAN.md ข้อ 5.5)
    // มีเทสต์: src/infrastructure/__tests__/firestore.rules.firebase.test.ts
    match /users/{uid}/plans/{planId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
